# Variables de entorno — ClubLab
# Copia este archivo como .env.local y rellena los valores reales.

# ──────────────────────────────────────
# Supabase
# ──────────────────────────────────────
# URL pública del proyecto Supabase (visible en: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública (safe para exponer en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de rol de servicio (¡NUNCA expongas esta clave en el frontend!)
# Solo necesaria para scripts de administración de datos
SUPABASE_SERVICE_ROLE_KEY=
